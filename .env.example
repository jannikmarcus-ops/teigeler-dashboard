# Notion API Integration
# 1. Erstelle eine Integration: https://www.notion.so/my-integrations
# 2. Kopiere den "Internal Integration Token"
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Makler-Datenbank ID
# Finde die ID in der Notion-URL: https://www.notion.so/[workspace]/[DATABASE_ID]?v=...
NOTION_MAKLER_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Separate Datenbank fuer Revenue-Daten
# Falls nicht gesetzt, werden die statischen Revenue-Daten aus dem Code verwendet
NOTION_REVENUE_DB_ID=
